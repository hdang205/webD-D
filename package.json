{
  "name": "dd-fashion-erp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "main.cjs",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "db:seed": "tsx src/db/seed.ts",
    "db:verify": "tsx src/db/verify.ts",
    "test:auth": "tsx src/server/testAuth.ts",
    "test:change-password": "tsx src/server/testChangePassword.ts",
    "test:crud": "tsx src/server/testCrud.ts",
    "test:purchases": "tsx src/server/testPurchases.ts",
    "db:init-stock": "tsx src/server/scripts/initStock.ts",
    "test:init-stock": "tsx src/server/testInitialStock.ts",
    "test:sales": "tsx src/server/testSales.ts",
    "test:inventory": "tsx src/server/testInventory.ts",
    "test:audit": "tsx src/server/testPhase8Audit.ts",
    "electron:dev": "electron .",
    "electron:build": "npm run build && npx electron-builder"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "build": {
    "appId": "com.ddfashion.erp",
    "productName": "DDFashionERP",
    "directories": {
      "output": "dist_electron"
    },
    "win": {
      "target": [
        "portable"
      ],
      "requestedExecutionLevel": "highestAvailable"
    },
    "files": [
      "dist/**/*",
      "main.cjs",
      "preload.js",
      "package.json"
    ],
    "asar": false
  }
}
